# Data & models (fetched by scripts, never committed). Anchored to the repo
# root: unanchored, `data/` also swallowed reports/data, so evidence dumps
# meant to be committed were silently dropped from `git add`.
/data/
!/data/.gitkeep
/models/
*.pdf
# Plots are regenerable binaries; metric dumps are evidence. A number quoted in
# a report should be re-checkable without re-running the pipeline that produced it.
reports/**/*.png

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local infra state
qdrant_storage/
.env

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
