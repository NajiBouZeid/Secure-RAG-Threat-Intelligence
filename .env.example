# Copy to .env and adjust. Never commit .env.

# NVD API key, requested free from https://nvd.nist.gov/developers/request-an-api-key
# Optional: without it the fetcher throttles to the public rate limit instead.
# The NVD terms of use forbid sharing a key, so it lives here and never in a
# config file, a log line, or a report.
NVD_API_KEY=

THREATRAG_QDRANT_URL=http://localhost:6333
THREATRAG_OLLAMA_URL=http://localhost:11434
THREATRAG_CONFIG=configs/base.yaml
THREATRAG_DATA_DIR=data
